{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "common-ground",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  // FREE TIER ONLY — workers.dev, no paid plan, no Queues/AI/R2/Containers.
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "preview",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,https://common-ground.issue-atharva.workers.dev",
    // Non-secret. Set QLOO_API_KEY via `wrangler secret put` only — never commit it.
    "QLOO_BASE_URL": "https://hackathon.api.qloo.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "common-ground",
      "database_id": "b2330142-33e8-42f1-a1e1-e18307781f07",
      "migrations_dir": "migrations"
    }
  ]
}
